{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_NATIVE_CURSOR": "1"
  },
  "theme": "custom:zinc",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
