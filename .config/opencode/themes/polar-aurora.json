{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["green", "cyan", "blue", "purple", "yellow"],
    "text": {
      "base": "#cfdae2",
      "muted": "#7e878f",
      "action": {
        "primary": {"base": "#6ef2b8", "$hovered": "#79eeb9", "$focused": "#0b1016", "$disabled": "#626a72"},
        "secondary": {"base": "#7e878f", "$hovered": "#cfdae2", "$focused": "#0b1016"},
        "destructive": {"base": "#0b1016", "$disabled": "#626a72"}
      },
      "formfield": {"base": "#cfdae2", "$focused": "#6ef2b8", "$disabled": "#626a72"},
      "feedback": {
        "error": {"base": "#ee7189"},
        "warning": {"base": "#e5c568"},
        "success": {"base": "#55dfa2"},
        "info": {"base": "#5fa5e8"}
      }
    },
    "background": {
      "base": "transparent",
      "raised": {"base": "transparent", "high": "#12171c", "max": "#1b2026"},
      "action": {
        "primary": {"base": "transparent", "$hovered": "#1a2e2d", "$focused": "#6ef2b8", "$selected": "#1a2e2d"},
        "secondary": {"base": "transparent", "$hovered": "#1b2026", "$focused": "#6ef2b8"},
        "destructive": {"base": "#ee7189", "$hovered": "#f78da1", "$disabled": "#2b3138"}
      },
      "formfield": {"base": "transparent", "$hovered": "#12171c", "$focused": "#12171c", "$selected": "#1d3547"},
      "feedback": {
        "error": {"base": "#2a1f26"},
        "warning": {"base": "#272924"},
        "success": {"base": "#172c2a"},
        "info": {"base": "#172432"}
      }
    },
    "border": {"base": "#2b3138"},
    "scrollbar": {"base": "#4c535a"},
    "diff": {
      "text": {"added": "#55dfa2", "removed": "#ee7189", "context": "#7e878f", "hunkHeader": "#5fa5e8"},
      "background": {"added": "#172c2a", "removed": "#2a1f26", "context": "transparent"},
      "highlight": {"added": "#79eeb9", "removed": "#f78da1"},
      "lineNumber": {"text": "#626a72", "background": {"added": "#172c2a", "removed": "#2a1f26"}}
    },
    "syntax": {
      "comment": "#7e878f",
      "keyword": "#a888ef",
      "function": "#82bcf2",
      "variable": "#cfdae2",
      "string": "#79eeb9",
      "number": "#e5c568",
      "type": "#6ce5e8",
      "operator": "#47d3d6",
      "punctuation": "#a9bac6"
    },
    "markdown": {
      "text": "#cfdae2",
      "heading": "#6ef2b8",
      "link": "#82bcf2",
      "linkText": "#6ce5e8",
      "code": "#79eeb9",
      "blockQuote": "#7e878f",
      "emphasis": "#cfdae2",
      "strong": "#e8f1f7",
      "horizontalRule": "#2b3138",
      "listItem": "#6ef2b8",
      "listEnumeration": "#47d3d6",
      "image": "#82bcf2",
      "imageText": "#6ce5e8",
      "codeBlock": "#cfdae2"
    },
    "@dialog": {
      "background": {
        "base": "#0f1419",
        "formfield": {"base": "#0f1419"},
        "action": {"primary": {"$hovered": "#1b2026"}}
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {"100": "#e8f1f7", "200": "#cfdae2", "300": "#a9bac6", "400": "#7e878f", "500": "#626a72", "600": "#3e454d", "700": "#2b3138", "800": "#12171c", "900": "#0b1016"},
      "red": {"100": "#ffd2dc", "200": "#ee7189", "300": "#d9657c", "400": "#bc5d70", "500": "#8c4957", "600": "#5f3640", "700": "#35232a", "800": "#2a1f26", "900": "#1b151b"},
      "orange": {"100": "#ffe0bc", "200": "#eba677", "300": "#cc9a70", "400": "#ab9a70", "500": "#8a946c", "600": "#668c69", "700": "#3a8465", "800": "#272924", "900": "#191b18"},
      "yellow": {"100": "#f1d787", "200": "#e5c568", "300": "#d1cb74", "400": "#bad180", "500": "#a1d68b", "600": "#81db97", "700": "#576753", "800": "#272924", "900": "#191b18"},
      "green": {"100": "#b5ffe0", "200": "#6ef2b8", "300": "#55dfa2", "400": "#48b183", "500": "#3a8465", "600": "#2c5b49", "700": "#1d342f", "800": "#172c2a", "900": "#0d1c1b"},
      "cyan": {"100": "#adf8fa", "200": "#47d3d6", "300": "#4fc0b7", "400": "#4da8ac", "500": "#4991a1", "600": "#447a96", "700": "#2b4a4f", "800": "#172c2a", "900": "#0d1c1b"},
      "blue": {"100": "#b9dcff", "200": "#5fa5e8", "300": "#4e84b9", "400": "#3e648c", "500": "#2d4661", "600": "#1d3547", "700": "#1d2a39", "800": "#172432", "900": "#0b1016"},
      "purple": {"100": "#dfccff", "200": "#a888ef", "300": "#9c8fee", "400": "#9079c7", "500": "#745780", "600": "#6b495f", "700": "#453a4c", "800": "#2a1f26", "900": "#1b151b"},
      "accent": "$hue.green",
      "interactive": "$hue.green",
      "neutral": "$hue.gray"
    }
  }
}
