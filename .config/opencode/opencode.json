{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "vercel deploy*": "ask",
      "vercel * --prod*": "ask",
      "vercel env add*": "ask",
      "vercel env rm*": "ask",
      "vercel alias*": "ask",
      "vercel rollback*": "ask"
    }
  },
  "plugin": ["@plannotator/opencode@latest"],
  "mcp": {
    "zapier-mcp": {
      "type": "remote",
      "url": "{env:ZAPIER_MCP_URL}",
      "enabled": true
    },
    "sherlock": {
      "type": "remote",
      "url": "https://sherlockbackend.global-us-east-1.int.zapier.com/v1/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "planetscale": {
      "type": "remote",
      "url": "https://mcp.pscale.dev/mcp/planetscale",
      "enabled": true
    },
    "servers": {
      "computer-use": {
        "type": "local",
        "command": [
          "/Users/jbaldwin/.local/share/computer-use/node_modules/.bin/codex-computer-use-mcp"
        ]
      }
    }
  }
}
