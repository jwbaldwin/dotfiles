{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "zinc",
    "mode": "dark"
  },
  "keybinds": {
    "command.palette.show": "ctrl+o",
    "session.rename": "none",
    "model.cycle_favorite": "tab",
    "agent.cycle": "shift+tab",
    "agent.cycle.reverse": "none"
  },
  "plugins": [
    "-opencode.btw",
    "./cli-plugins/session-tools",
    "opencode-quick-quote",
    "/Users/jbaldwin/repos/projects/rex-relay"
  ],
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": false,
    "volume": 0.30000000000000004
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "enabled": false
  }
}
