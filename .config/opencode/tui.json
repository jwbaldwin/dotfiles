{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight-transparent",
  "plugin": ["./plugin/tmux-status/index.js"],
  "keybinds": {
    "command_list": "ctrl+o",
    "session_rename": "none",
    "agent_cycle": "shift+tab",
    "agent_cycle_reverse": "none",
    "model_cycle_favorite": "tab"
  },
  "attention": {
    "enabled": true,
    "notifications": false,
    "sound": false,
    "volume": 0.4
  }
}
